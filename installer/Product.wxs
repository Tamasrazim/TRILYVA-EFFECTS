<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="TRILYVA EDIT"
    Manufacturer="Tamasrazim"
    Version="$(var.ProductVersion)"
    UpgradeCode="{D1847F70-5E36-4E71-BB65-9A7F88DCB742}"
    Scope="perUserOrMachine"
    InstallerVersion="500">

    <SummaryInformation
      Description="TRILYVA EDIT panel for Adobe After Effects"
      Manufacturer="Tamasrazim"/>

    <MajorUpgrade DowngradeErrorMessage="A newer version of TRILYVA EDIT is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AdobeFolder" Name="Adobe">
        <Directory Id="CepFolder" Name="CEP">
          <Directory Id="ExtensionsFolder" Name="extensions">
            <Directory Id="INSTALLFOLDER" Name="com.tamasrazim.trilyvaedit">
              <Directory Id="CSXSFolder" Name="CSXS"/>
              <Directory Id="JSFolder" Name="js"/>
              <Directory Id="JSXFolder" Name="jsx"/>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="TRILYVA EDIT" Level="1">
      <ComponentGroupRef Id="PanelRootFiles"/>
      <ComponentGroupRef Id="PanelCsxsFiles"/>
      <ComponentGroupRef Id="PanelJsFiles"/>
      <ComponentGroupRef Id="PanelJsxFiles"/>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PanelRootFiles" Directory="INSTALLFOLDER">
      <Component Id="cmpIndexHtml" Guid="{A72B1943-2E44-4EC1-9500-DA7C9CF29B11}">
        <File Source="!(bindpath.SourceDir)\index.html"/>
      </Component>
      <Component Id="cmpStylesCss" Guid="{B4D6BBF3-F8AD-482E-A10E-DB9EF3DA1AC2}">
        <File Source="!(bindpath.SourceDir)\styles.css"/>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="PanelCsxsFiles" Directory="CSXSFolder">
      <Component Id="cmpManifestXml" Guid="{C1AB7C5A-4812-4E7D-B78C-64F69753B2D3}">
        <File Source="!(bindpath.SourceDir)\CSXS\manifest.xml"/>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="PanelJsFiles" Directory="JSFolder">
      <Component Id="cmpMainJs" Guid="{D2C45DA6-7B34-4FC3-9D57-75D5D9F3C4E5}">
        <File Source="!(bindpath.SourceDir)\js\main.js"/>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="PanelJsxFiles" Directory="JSXFolder">
      <Component Id="cmpHostJsx" Guid="{E3D56EB7-8C45-40D4-AE68-86E6E0A4D5F6}">
        <File Source="!(bindpath.SourceDir)\jsx\host.jsx"/>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
